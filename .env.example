DATABASE_URL="postgresql://temple:temple_dev_password@localhost:5432/temple_dev?schema=public"

# NextAuth / Auth.js
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Payment gateway (CR-001 BLOCKING DECISION — gateway not finalized; adapter defaults to a mock provider in dev)
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional email (FEAT-071 password reset; receipts remain download/lookup-only,
# not emailed) — gateway-agnostic like PAYMENT_PROVIDER above. Defaults to a
# console/file-logging provider requiring no setup; set EMAIL_PROVIDER="smtp"
# plus the SMTP_* vars below for a real deployment against any standard SMTP relay.
EMAIL_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Object storage (media uploads) — Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Security: mock payments are refused when NODE_ENV=production. Set this to
# "true" only on a staging deployment that deliberately uses PAYMENT_PROVIDER=mock.
ALLOW_MOCK_PAYMENTS=""

# Required when running `prisma db seed` against a production database — the
# seed refuses to create admin accounts with the default password there.
BOOTSTRAP_ADMIN_PASSWORD=""
