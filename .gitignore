# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local receipt PDF storage (dev fallback until S3 is wired — see IMPLEMENTATION_ENVIRONMENT.md)
/.data

# browser-verification screenshots (regenerate via scripts/verification/*.mjs, not source)
/.verification

# Playwright test artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# --- Not part of the application -------------------------------------------
# AI/editor tooling
/.agents/
/.claude/
/.windsurf/
/skills-lock.json
/AGENTS.md
/CLAUDE.md

# Planning & build notes, source content, one-off verification scripts
/blueprint/
/IMPLEMENTATION_ENVIRONMENT.md
/IMPLEMENTATION_PROGRESS.md
/*.docx
/scripts/
